# God's Bookmark 环境变量配置模板
# 复制此文件为 .env 并修改相应的配置值

# 运行环境
NODE_ENV=production

# 服务端口
PORT=3000

# 管理员密码（生产环境请修改为强密码）
# 默认管理员账号为：admin
ADMIN_PASSWORD=your_secure_password_here

# 备份根目录（可选）：本地/NAS 备份的唯一写入位置
# 不设置时默认为 <项目>/backups；NAS 场景请将 NAS 挂载到该目录，
# 或将 BACKUP_ROOT_DIR 指向容器内的挂载路径
# BACKUP_ROOT_DIR=/app/backups
